# Copy this file to .env (same folder) and fill it in. NEVER commit .env or share it.
# Where to get each value: docs/SETUP.md

# SmartAPI key from https://smartapi.angelbroking.com (My Apps -> create app)
ANGEL_API_KEY=

# Your Angel One client ID (the one you log in with)
ANGEL_CLIENT_CODE=

# Your 4-digit Angel One login PIN
ANGEL_PIN=

# The TOTP secret shown as text when you enable TOTP for SmartAPI (not the 6-digit code)
ANGEL_TOTP_SECRET=
